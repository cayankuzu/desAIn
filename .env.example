# Server-only keys (do NOT use NEXT_PUBLIC_).
# Copy to .env.local and restart `npm run dev`.
# You can switch providers later by changing the `AI_*` values only.

# Vision provider for photo analysis
AI_VISION_PROVIDER=gemini
AI_VISION_MODEL=gemini-2.5-flash
AI_VISION_API_KEY=

# Chat/layout provider
AI_CHAT_PROVIDER=groq
AI_CHAT_MODEL=llama-3.3-70b-versatile
AI_CHAT_API_KEY=

# Legacy provider-specific keys remain supported
GEMINI_API_KEY=
GROQ_API_KEY=
