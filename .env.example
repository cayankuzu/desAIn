# App runtime selection
DESAIN_RUNTIME_ENV=local

# Session cookie name
DESAIN_SESSION_COOKIE_NAME=desain_session

# Optional: override the SQLite file path.
# On Vercel this defaults to /tmp automatically because /var/task is read-only.
# DESAIN_DATABASE_FILE_PATH=

# Production persistence on Vercel:
# connect Vercel Blob so BLOB_READ_WRITE_TOKEN is injected automatically.
# Optional custom object key:
# DESAIN_DATABASE_BLOB_PATHNAME=databases/production/desain.production.sqlite
